# doubao2api 环境变量配置
# 复制此文件为 .env 并按需修改（Docker Compose 会自动读取同目录的 .env）

# 【Docker 部署】重点关注：
#   DOUBAO_PORT     宿主机映射端口（默认 9090）
#   DOUBAO_API_KEY  API 鉴权密钥（必填！docker-compose.yml 已改为强制要求，未设置会直接报错）
# 生成密钥：openssl rand -hex 32
# 其余变量 Docker 场景保持默认即可（compose 已透传其 environment 中声明的变量）。

# ── 服务基础 ────────────────────────────────────────────────

# 监听地址（Docker 部署用 0.0.0.0；仅本机访问可用 127.0.0.1）
DOUBAO_HOST=127.0.0.1

# 服务端口
DOUBAO_PORT=9090

# API 密钥（用于保护 /v1/* 与 /admin 端点，留空则不鉴权；设为 any 接受任意非空 key）
DOUBAO_API_KEY=

# 每分钟请求限制（所有端点共享；0 = 禁用限流）
DOUBAO_RPM_LIMIT=50

# CORS 允许的 Origin 列表（逗号分隔，如 https://app.example.com,https://foo.example.com）
# 留空 = 不发送任何 CORS 响应头（最安全，默认）
DOUBAO_CORS_ORIGINS=

# ── 浏览器 / 登录态 ─────────────────────────────────────────

# Chromium 是否无头运行（Linux Docker 用 xvfb 以有头模式运行，避免被风控）
DOUBAO_HEADLESS=true

# Chromium 持久化用户目录（登录态所在；不设置时默认 ~/.doubao_browser）
# 提示：环境变量里不会展开 "~"，请填绝对路径
# DOUBAO_BROWSER_DATA=/opt/doubao2api/.browser_data

# 直接注入 Cookie 头（sessionid=...; ttwid=...），优先于 session 文件；一般留空
DOUBAO_COOKIE=

# Admin 面板中的 noVNC 地址（留空 = 自动推断）
DOUBAO_NOVNC_URL=

# noVNC 密码（自动拼接到 noVNC URL）
DOUBAO_NOVNC_PASSWORD=

# ── 安全 ────────────────────────────────────────────────────

# 管理调试开关（默认 false）。开启后才允许 POST /auth/eval，
# 且 /admin/api/cookies 才会返回明文 Cookie 值 —— 生产环境请保持关闭！
DOUBAO_ENABLE_ADMIN_DEBUG=false

# 允许远程 file_url 下载内网/私有地址（默认 false，防 SSRF；仅可信内网环境才开启）
DOUBAO_ALLOW_PRIVATE_FILE_URLS=false

# 远程 file_url 下载大小上限（MB）
DOUBAO_FILE_URL_MAX_MB=50

# 上游限流（710022004）后的本地冷却秒数，期间聊天请求返回 429
DOUBAO_RATE_LIMIT_COOLDOWN=120

# ── 千问（Qianwen）上游（可选） ──────────────────────────────

# 启用后在同一个服务里额外提供 qianwen-* 模型
QIANWEN_ENABLED=false

# 千问浏览器是否无头运行
QIANWEN_HEADLESS=true

# 千问浏览器持久化用户目录（不设置时默认 ~/.qianwen_browser；同样请填绝对路径）
# QIANWEN_BROWSER_DATA=/opt/doubao2api/.qianwen_browser

# 千问工具调用时混淆工具名（规避上游对工具名的拦截）
QIANWEN_OBFUSCATE_TOOLS=false
